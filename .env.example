# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pmis?retryWrites=true&w=majority

# NextAuth.js
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3070

# Google OAuth
# Either set AUTH_GOOGLE_* or GOOGLE_CLIENT_*
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Runtime flag
# true: login required, false: dev bypass enabled (non-production only)
PMIS_REQUIRE_LOGIN=true

# S3 Compatible Storage (optional / future use)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
